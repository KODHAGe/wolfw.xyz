eb3411-1263x1270.png 1263w","srcWebp":"https://cdn.sanity.io/images/5re0s6iv/prod/3aee9a8e3b31e7c9c2ff582580d755b50ceb3411-1263x1270.png?w=700&h=704&fit=crop&fm=webp","srcSetWebp":"https://cdn.sanity.io/images/5re0s6iv/prod/3aee9a8e3b31e7c9c2ff582580d755b50ceb3411-1263x1270.png?w=175&h=176&fit=crop&fm=webp 175w,\nhttps://cdn.sanity.io/images/5re0s6iv/prod/3aee9a8e3b31e7c9c2ff582580d755b50ceb3411-1263x1270.png?w=350&h=352&fit=crop&fm=webp 350w,\nhttps://cdn.sanity.io/images/5re0s6iv/prod/3aee9a8e3b31e7c9c2ff582580d755b50ceb3411-1263x1270.png?w=700&h=704&fit=crop&fm=webp 700w,\nhttps://cdn.sanity.io/images/5re0s6iv/prod/3aee9a8e3b31e7c9c2ff582580d755b50ceb3411-1263x1270.png?w=1050&h=1056&fit=crop&fm=webp 1050w,\nhttps://cdn.sanity.io/images/5re0s6iv/prod/3aee9a8e3b31e7c9c2ff582580d755b50ceb3411-1263x1270.png?fm=webp 1263w","sizes":"(max-width: 700px) 100vw, 700px"}}},"_rawBody":[{"_key":"98c2697ee9c7","_type":"block","children":[{"_key":"98c2697ee9c70","_type":"span","marks":[],"text":"An instrument of instruments, rain of emoji."}],"markDefs":[],"style":"normal"},{"_key":"b883aa6b057f","_type":"block","children":[{"_key":"b883aa6b057f0","_type":"span","marks":[],"text":"Built with OpenFrameworks, node.js and plain javascript-in-a-browser, Instru-mental allows remote control of sound through any networked, gyroscope or accelerometer equipped device through tilting and moving. The networked device controls the point of gravity in a visualization created in OpenFrameworks, which in turn controls the sound generated, allowing the user a unique interface with which to control the sound. Course project for Multimedia Authoring @ Aalto University."}],"markDefs":[],"style":"normal"},{"_key":"cd19088c34d3","_type":"image","asset":{"_ref":"image-5ad1068e90c18ff243846f6082e3cc53a93ee791-2456x1402-png","_type":"reference"}},{"_key":"bf01ff376899","_type":"image","asset":{"_ref":"image-753851c932bc98ffab47de2588914c02bf4c404b-1478x1278-png","_type":"reference"}},{"_key":"08bb035d27c5","_type":"image","asset":{"_ref":"image-85fdef5b676069de3c2eb95f84328f7ee5dcec09-1930x1286-png","_type":"reference"}},{"_key":"0aabd32635ae","_type":"image","asset":{"_ref":"image-da3454dd49afe0e958841851d997500f43be9e65-1420x1284-png","_type":"reference"}}],"categories":[{"title":"Experiment","id":"f8a6cc19-4c9e-58bf-9c56-fab343a453f9"}]}},{"node":{"id":"380740df-6b24-5d4c-aaf6-21349ca90437","title":"I can't let you do that, human","slug":{"_key":null,"_type":"slug","current":"i-can-t-let-you-do-that-human"},"publishedAt":"2016-05-30T21:00:00.000Z","author":null,"mainImage":{"_key":null,"_type":"image","asset":{"id":"image-8ab225afc0e5e3ad3578e7b6247a07f0a5a277ec-1263x1270-png","url":"https://cdn.sanity.io/images/5re0s6iv/prod/8ab225afc0e5e3ad3578e7b6247a07f0a5a277ec-1263x1270.png","fluid":{"base64":"data:image/png;base64,","aspectRatio":0.9944881889763779,"src":"https://cdn.sanity.io/images/5re0s6iv/prod/8ab225afc0e5e3ad3578e7b6247a07f0a5a277ec-1263x1270.png?w=700&h=704&fit=crop","srcSet":"https://cdn.sanity.io/images/5re0s6iv/prod/8ab225afc0e5e3ad3578e7b6247a07f0a5a277ec-1263x1270.png?w=175&h=176&fit=crop 175w,\nhttps://cdn.sanity.io/images/5re0s6iv/prod/8ab225afc0e5e3ad3578e7b6247a07f0a5a277ec-1263x1270.png?w=350&h=352&fit=crop 350w,\nhttps://cdn.sanity.io/images/5re0s6iv/prod/8ab225afc0e5e3ad3578e7b6247a07f0a5a277ec-1263x1270.png?w=700&h=704&fit=crop 700w,\nhttps://cdn.sanity.io/images/5re0s6iv/prod/8ab225afc0e5e3ad3578e7b6247a07f0a5a277ec-1263x1270.png?w=1050&h=1056&fit=crop 1050w,\nhttps://cdn.sanity.io/images/5re0s6iv/prod/8ab225afc0e5e3ad3578e7b6247a07f0a5a277ec-1263x1270.png 1263w","srcWebp":"https://cdn.sanity.io/images/5re0s6iv/prod/8ab225afc0e5e3ad3578e7b6247a07f0a5a277ec-1263x1270.png?w=700&h=704&fit=crop&fm=webp","srcSetWebp":"https://cdn.sanity.io/images/5re0s6iv/prod/8ab225afc0e5e3ad3578e7b6247a07f0a5a277ec-1263x1270.png?w=175&h=176&fit=crop&fm=webp 175w,\nhttps://cdn.sanity.io/images/5re0s6iv/prod/8ab225afc0e5e3ad3578e7b6247a07f0a5a277ec-1263x1270.png?w=350&h=352&fit=crop&fm=webp 350w,\nhttps://cdn.sanity.io/images/5re0s6iv/prod/8ab225afc0e5e3ad3578e7b6247a07f0a5a277ec-1263x1270.png?w=700&h=704&fit=crop&fm=webp 700w,\nhttps://cdn.sanity.io/images/5re0s6iv/prod/8ab225afc0e5e3ad3578e7b6247a07f0a5a277ec-1263x1270.png?w=1050&h=1056&fit=crop&fm=webp 1050w,\nhttps://cdn.sanity.io/images/5re0s6iv/prod/8ab225afc0e5e3ad3578e7b6247a07f0a5a277ec-1263x1270.png?fm=webp 1263w","sizes":"(max-width: 700px) 100vw, 700px"}}},"_rawBody":[{"_key":"ca440e8f00f3","_type":"block","children":[{"_key":"ca440e8f00f30","_type":"span","marks":[],"text":"Kinects + Printers === A bad time"}],"markDefs":[],"style":"normal"},{"_key":"67e3ae2d6f36","_type":"block","children":[{"_key":"67e3ae2d6f360","_type":"span","marks":[],"text":"Borne out of the frustration everyone feels toward terrible user experiences with software and hardware, we explored the concept of 'fooling' machines through this Kinect based undetection game. The game consists of a physical location in which the player tries to pass a Kinect-sensor undetected in order to press an emergency stop button on the other side of the space. Built with Node.js, Javascript and OSCeleton and presented at Media Lab Spring Demo Day 2016."}],"markDefs":[],"style":"normal"},{"_key":"31a467bc2959","_type":"image","asset":{"_ref":"image-658ada5f30b9c02a65378a1e4e0ff4d10f0600ec-1974x1422-png","_type":"reference"}},{"_key":"1ed6a054075d","_type":"image","asset":{"_ref":"image-73a84b769d28900b54593f7e9abbdcc41e574d56-1594x682-png","_type":"reference"}},{"_key":"f686916e73d0","_type":"image","asset":{"_ref":"image-e138fe2623d99079bf1f59ba1fe2cb0ae86f6baf-1786x1450-png","_type":"reference"}}],"categories":[{"title":"Experiment","id":"f8a6cc19-4c9e-58bf-9c56-fab343a453f9"}]}},{"node":{"id":"d2f5f05a-39d6-50cc-b828-2ce022cb8d06","title":"Eurovision Self-Organized","slug":{"_key":null,"_type":"slug","current":"eurovision-som"},"publishedAt":"2015-12-29T22:00:00.000Z","author":null,"mainImage":{"_