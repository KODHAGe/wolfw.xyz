{"_ref":"image-3bdb3c70f5e3ec05112ccf36c0adaa9b81edc28e-14044x9934-jpg","_type":"reference"}},{"_key":"71c68f266139","_type":"block","children":[{"_key":"71c68f2661390","_type":"span","marks":[],"text":"Conversion #3"}],"markDefs":[],"style":"normal"}],"categories":[{"title":"Experiment","id":"f8a6cc19-4c9e-58bf-9c56-fab343a453f9"}]}},{"node":{"id":"c6f33989-e345-5b2f-9d3a-c50d504bf659","title":"Beyond Shape","slug":{"_key":null,"_type":"slug","current":"beyond-shape"},"publishedAt":"2019-05-29T21:00:00.000Z","author":null,"mainImage":{"_key":null,"_type":"image","asset":{"id":"image-e20ab6601278817799e1a9b6c7eb9f2e447a491c-1263x1270-png","url":"https://cdn.sanity.io/images/5re0s6iv/prod/e20ab6601278817799e1a9b6c7eb9f2e447a491c-1263x1270.png","fluid":{"base64":"data:image/png;base64,","aspectRatio":0.9944881889763779,"src":"https://cdn.sanity.io/images/5re0s6iv/prod/e20ab6601278817799e1a9b6c7eb9f2e447a491c-1263x1270.png?w=700&h=704&fit=crop","srcSet":"https://cdn.sanity.io/images/5re0s6iv/prod/e20ab6601278817799e1a9b6c7eb9f2e447a491c-1263x1270.png?w=175&h=176&fit=crop 175w,\nhttps://cdn.sanity.io/images/5re0s6iv/prod/e20ab6601278817799e1a9b6c7eb9f2e447a491c-1263x1270.png?w=350&h=352&fit=crop 350w,\nhttps://cdn.sanity.io/images/5re0s6iv/prod/e20ab6601278817799e1a9b6c7eb9f2e447a491c-1263x1270.png?w=700&h=704&fit=crop 700w,\nhttps://cdn.sanity.io/images/5re0s6iv/prod/e20ab6601278817799e1a9b6c7eb9f2e447a491c-1263x1270.png?w=1050&h=1056&fit=crop 1050w,\nhttps://cdn.sanity.io/images/5re0s6iv/prod/e20ab6601278817799e1a9b6c7eb9f2e447a491c-1263x1270.png 1263w","srcWebp":"https://cdn.sanity.io/images/5re0s6iv/prod/e20ab6601278817799e1a9b6c7eb9f2e447a491c-1263x1270.png?w=700&h=704&fit=crop&fm=webp","srcSetWebp":"https://cdn.sanity.io/images/5re0s6iv/prod/e20ab6601278817799e1a9b6c7eb9f2e447a491c-1263x1270.png?w=175&h=176&fit=crop&fm=webp 175w,\nhttps://cdn.sanity.io/images/5re0s6iv/prod/e20ab6601278817799e1a9b6c7eb9f2e447a491c-1263x1270.png?w=350&h=352&fit=crop&fm=webp 350w,\nhttps://cdn.sanity.io/images/5re0s6iv/prod/e20ab6601278817799e1a9b6c7eb9f2e447a491c-1263x1270.png?w=700&h=704&fit=crop&fm=webp 700w,\nhttps://cdn.sanity.io/images/5re0s6iv/prod/e20ab6601278817799e1a9b6c7eb9f2e447a491c-1263x1270.png?w=1050&h=1056&fit=crop&fm=webp 1050w,\nhttps://cdn.sanity.io/images/5re0s6iv/prod/e20ab6601278817799e1a9b6c7eb9f2e447a491c-1263x1270.png?fm=webp 1263w","sizes":"(max-width: 700px) 100vw, 700px"}}},"_rawBody":[{"_key":"d8f9098f4b7c","_type":"block","children":[{"_key":"d8f9098f4b7c0","_type":"span","marks":[],"text":"My thesis project for MA in New Media Production at Aalto University."}],"markDefs":[],"style":"normal"},{"_key":"7d8e4149e4d7","_type":"block","children":[{"_key":"7d8e4149e4d70","_type":"span","marks":[],"text":"More content will follow, watch this space."}],"markDefs":[],"style":"normal"},{"_key":"c9af8c77e613","_type":"block","children":[{"_key":"c9af8c77e6130","_type":"span","marks":[],"text":""},{"_key":"c9af8c77e6131","_type":"span","marks":["186eefe7cd41"],"text":"Check out the print edition on Aaltodoc"},{"_key":"c9af8c77e6132","_type":"span","marks":[],"text":""}],"markDefs":[{"_key":"186eefe7cd41","_type":"link","href":"https://aaltodoc.aalto.fi/handle/123456789/38070"}],"style":"normal"},{"_key":"c5609e1ed035","_type":"block","children":[{"_key":"c5609e1ed0350","_type":"span","marks":[],"text":""},{"_key":"c5609e1ed0351","_type":"span","marks":["789dee68732f"],"text":"Contribute to the data collection"},{"_key":"c5609e1ed0352","_type":"span","marks":[],"text":""}],"markDefs":[{"_key":"789dee68732f","_type":"link","href":"https://shape-mapper.now.sh/"}],"style":"normal"},{"_key":"56580b680071","_type":"block","children":[{"_key":"56580b6800710","_type":"span","marks":[],"text":"Process"}],"markDefs":[],"style":"normal"},{"_key":"682417fed071","_type":"block","children":[{"_key":"682417fed0710","_type":"span","marks":[],"text":"Defining the 'third wave of visualization'"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"558d6cfdd021","_type":"block","children":[{"_key":"558d6cfdd0210","_type":"span","marks":[],"text":"Developing a concept of visualizing data in a way that could also communicate some of the fuzziness, uncertainty of interpretation included in the presentation."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"62f102a0eef6","_type":"block","children":[{"_key":"62f102a0eef60","_type":"span","marks":[],"text":"Building a text-to-emotional-attribute API utilizing the natural language understanding platforms of IBM Watson, Google Cloud and Azure"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"ecde9d1eecbe","_type":"block","children":[{"_key":"ecde9d1eecbe0","_type":"span","marks":[],"text":"Building a real-time user research platform for collecting quantifiable perception data of visual-attribute – emotional-attribute pairs in Vue"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"ae5a3b179469","_type":"block","children":[{"_key":"ae5a3b1794690","_type":"span","marks":[],"text":"Automate user research data gathering utilizing Amazon Mechanical Turk"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"21da505ce9ff","_type":"block","children":[{"_key":"21da505ce9ff0","_type":"span","marks":[],"text":"Design and implement an experimental neural network that extrapolates visual attributes from emotional attributes in Tensorflow"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"0755e3aff8b8","_type":"block","children":[{"_key":"0755e3aff8b80","_type":"span","marks":[],"text":"Design a visualization of visual attribute outcomes utilizing React and Aframe (three.js)"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"7f3664f96de6","_type":"block","children":[{"_key":"7f3664f96de60","_type":"span","marks":[],"text":"Re-render visualizations in Blender"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},