cdn.sanity.io/images/5re0s6iv/prod/69ffe45f4fe2c069b8622400586171fa692b94d7-1495x1499.png?fm=webp 1495w","sizes":"(max-width: 700px) 100vw, 700px"}}},"_rawBody":[{"_key":"50ba8b7eda57","_type":"block","children":[{"_key":"50ba8b7eda570","_type":"span","marks":[],"text":"Eurovision Self-Organized is an exploration of both Eurovision and "},{"_key":"50ba8b7eda571","_type":"span","marks":["7eb5a0f6c553"],"text":"Self-Organizing Map neural networks."},{"_key":"50ba8b7eda572","_type":"span","marks":[],"text":" We analyzed eurovision entries, breaking them down into quantifiable attributes and processed them with the SOM to find groups of similarities within the set of songs. This visualization is a real-time demo of organizing the map "},{"_key":"50ba8b7eda573","_type":"span","marks":["65a36b17e769"],"text":"with this library"},{"_key":"50ba8b7eda574","_type":"span","marks":[],"text":", and placing the values within the organized map, created with "},{"_key":"50ba8b7eda575","_type":"span","marks":["84b8f60328f6"],"text":"peity"},{"_key":"50ba8b7eda576","_type":"span","marks":[],"text":" and plain javascript. This visualization was created as part of the Information Visualization and Design course at Aalto MediaLab, in collaboration with "},{"_key":"50ba8b7eda577","_type":"span","marks":["93b7d21cfbdb"],"text":"Marija Erjavec"},{"_key":"50ba8b7eda578","_type":"span","marks":[],"text":".\n"}],"markDefs":[{"_key":"7eb5a0f6c553","_type":"link","href":"https://en.wikipedia.org/wiki/Self-organizing_map"},{"_key":"65a36b17e769","_type":"link","href":"https://github.com/mljs/som/"},{"_key":"84b8f60328f6","_type":"link","href":"http://benpickles.github.io/peity/"},{"_key":"93b7d21cfbdb","_type":"link","href":"https://www.behance.net/gallery/38347953/Eurovision-Visualisation"}],"style":"normal"},{"_key":"06d3db04f7e3","_type":"block","children":[{"_key":"06d3db04f7e30","_type":"span","marks":[],"text":""},{"_key":"06d3db04f7e31","_type":"span","marks":["4a534b1ae3dd"],"text":"Check out the demo here:"},{"_key":"06d3db04f7e32","_type":"span","marks":[],"text":""}],"markDefs":[{"_key":"4a534b1ae3dd","_type":"link","href":"http://esc-som.herokuapp.com/"}],"style":"normal"},{"_key":"376c27010501","_type":"block","children":[{"_key":"376c270105010","_type":"span","marks":[],"text":"Process:"}],"markDefs":[],"style":"normal"},{"_key":"cfaced680c73","_type":"block","children":[{"_key":"cfaced680c730","_type":"span","marks":[],"text":"Brainstorming, ideation"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"bbfddaa79df6","_type":"block","children":[{"_key":"bbfddaa79df60","_type":"span","marks":[],"text":"Identifying quantifiable metrics within popular music"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"c361639baa2f","_type":"block","children":[{"_key":"c361639baa2f0","_type":"span","marks":[],"text":"Processing Eurovision entries break them down into identified attributes using both manual and software assisted means"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"af89ce66029f","_type":"block","children":[{"_key":"af89ce66029f0","_type":"span","marks":[],"text":"Developing a SOM-network that utilizes the quantified attributes"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"e787e177c31a","_type":"block","children":[{"_key":"e787e177c31a0","_type":"span","marks":[],"text":"Visualizing the progress and end result of that SOM-network"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"89338f4020ab","_type":"block","children":[{"_key":"89338f4020ab0","_type":"span","marks":[],"text":"Building a functional web-based prototype of the tool"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"}],"categories":[{"title":"Experiment","id":"f8a6cc19-4c9e-58bf-9c56-fab343a453f9"}]}}]}},"pageContext":{}}}