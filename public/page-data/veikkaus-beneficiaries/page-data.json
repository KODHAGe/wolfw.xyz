{"componentChunkName":"component---src-pages-project-page-js","path":"/veikkaus-beneficiaries","result":{"pageContext":{"slug":"veikkaus-beneficiaries","title":"Veikkaus beneficiaries","body":[{"_key":"ccfd81c7de69","_type":"block","children":[{"_key":"ccfd81c7de690","_type":"span","marks":[],"text":"Every year, the national lottery company of Finland distributes millions of euros of their profits back into the economy in the form of culture, sports, youth and science funding. While the recipients of these grants have been made public in prior years, we worked with Veikkaus to develop a tool in which this distribution could be observed in a more transparent fashion – this application being the end result of that process."}],"markDefs":[],"style":"normal"},{"_key":"ef46d2b6efc2","_type":"block","children":[{"_key":"ef46d2b6efc20","_type":"span","marks":[],"text":"Tech: jQuery, TaffyDB, Leaflet.js"}],"markDefs":[],"style":"normal"},{"_key":"73f56581c1cf","_type":"image","asset":{"_ref":"image-4d7cfda9aac158811939b521605135054ccc291e-1912x1416-png","_type":"reference"}},{"_key":"9a50a8740fc8","_type":"image","asset":{"_ref":"image-e2d2c4ace2226dfb8ec1ca0a071ec040243d2a05-644x540-png","_type":"reference"}},{"_key":"6d6fb0320b19","_type":"image","asset":{"_ref":"image-d328bcbfd94bf177334b737b026644bc5ce9124a-880x1146-png","_type":"reference"}}],"video":{"_key":null,"_type":null,"asset":{"_key":null,"_type":"mux.videoAsset","status":"ready","assetId":"1DfHrCUEJFDtBuvPz32U4zvgwH6by2tPzF5P400MZMTg","playbackId":"bF6CzqHl7bsvC3XQ2LdjXISRog5HiF7TyUgRPQbv35w","filename":null,"thumbTime":null}}}}}