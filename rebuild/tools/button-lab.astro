    </footer>

    <script>
      // Per-letter wave buttons — split [data-wave] into spans with staggered transition-delay
      for (const btn of document.querySelectorAll("[data-wave]")) {
        const text = btn.textContent;
        const cid = [...btn.attributes].find(a => a.name.startsWith("data-astro-cid"))?.name;
        btn.textContent = "";
        for (let i = 0; i < text.length; i++) {
          const s = document.createElement("span");
          s.className = "char";
          if (cid) s.setAttribute(cid, "");
          s.textContent = text[i] === " " ? "\u00a0" : text[i];
          // stagger only on hover — delay is baked into the span, but only matters when :hover triggers
          s.style.transitionDelay = `${i * 42}ms`;
          btn.appendChild(s);
        }
      }
      // Subtle wave — same but whisper: 62ms stagger, longer linger
      for (const btn of document.querySelectorAll("[data-wave-subtle]")) {
        const text = btn.textContent;
        const cid = [...btn.attributes].find(a => a.name.startsWith("data-astro-cid"))?.name;
        btn.textContent = "";
        for (let i = 0; i < text.length; i++) {
          const s = document.createElement("span");
          s.className = "char";
          if (cid) s.setAttribute(cid, "");
          s.textContent = text[i] === " " ? "\u00a0" : text[i];
          s.style.transitionDelay = `${i * 62}ms`;
          btn.appendChild(s);
        }
      }
      // Glass wave — frosted + per-letter, same whisper
      for (const btn of document.querySelectorAll("[data-wave-glass]")) {
        const text = btn.textContent;
        const cid = [...btn.attributes].find(a => a.name.startsWith("data-astro-cid"))?.name;
        btn.textContent = "";
        for (let i = 0; i < text.length; i++) {
          const s = document.createElement("span");
          s.className = "char";
          if (cid) s.setAttribute(cid, "");
          s.textContent = text[i] === " " ? "\u00a0" : text[i];
          s.style.transitionDelay = `${i * 62}ms`;
          btn.appendChild(s);
        }
      }
      // Stable wave — width-stable: MONO stays 1, only CASL/wght move so phrase never changes length
      for (const btn of document.querySelectorAll("[data-wave-stable]")) {
        const text = btn.textContent;
        const cid = [...btn.attributes].find(a => a.name.startsWith("data-astro-cid"))?.name;
        btn.textContent = "";
        for (let i = 0; i < text.length; i++) {
          const s = document.createElement("span");
          s.className = "char";
          if (cid) s.setAttribute(cid, "");
          s.textContent = text[i] === " " ? "\u00a0" : text[i];
          s.style.transitionDelay = `${i * 54}ms`;
          btn.appendChild(s);
        }
      }
      // Width-stable: lock outer width so MONO doesn't make the button grow.
      // Measure after wave splitting (spans now in place, still MONO 1), then
      // set --locked-w and add .btn-locked which applies width: var(--locked-w).
      for (const btn of document.querySelectorAll("[data-lock-width]")) {
        const w = Math.ceil(btn.getBoundingClientRect().width);
        btn.style.setProperty("--locked-w", w + "px");
        btn.classList.add("btn-locked");
      }
    </script>
  </body>
