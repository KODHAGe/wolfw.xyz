    <!-- 7 — Cost -->
    <section class="lab-section">
      <h2>7 — Cost, honestly</h2>
      <div class="cost">
        <div class="cost-card">
          <strong>Bytes</strong>
          <span>Necto 25 KB → Recursive latin 55 KB <em>(+30 KB)</em>. Against 2.0 MB of images, ~1.5% of total payload. Subsetting harder (only axes you use) could trim further, but 55 KB is already the latin-only subset.</span>
        </div>
        <div class="cost-card">
          <strong>Not compositor-accelerated</strong>
          <span><code>font-variation-settings</code> re-rasterises glyph outlines on the main thread every frame. Bounded one-shot on one <code>h1</code> is free. Continuous animation would be jank — same cost-model error as the SDF.</span>
        </div>
        <div class="cost-card">
          <strong>FOUT / reflow</strong>
          <span>55 KB replaces 25 KB — first-paint metrics move. Needs <code>size-adjust</code> fallback or CLS will shift. Current CLS 0.0000 is load-bearing.</span>
        </div>
        <div class="cost-card">
          <strong>One distinctive face → two</strong>
          <span>Recovered identity (R8.2) is single-typeface. Replacing Necto with Recursive keeps one face; <em>adding</em> Recursive alongside Necto makes two — a departure that belongs in <code>desired.md</code>.</span>
        </div>
      </div>
      <p class="lab-note" style="margin-top:0.8rem">
        <strong>GRAD</strong> (grade — perceived weight without advance-width change) would solve the centred-heading wobble, but Recursive doesn't have it.
        <code>wght</code> changes widths, so weight animation on centred text visibly reflows. <code>MONO</code> and <code>CASL</code> change letterforms without that specific wobble — the more honest animation axes for this site.
      </p>
    </section>

    <footer class="lab-footer">
      Lab font: <a href="https://fonts.google.com/specimen/Recursive" target="_blank" rel="noopener">Recursive</a> by Arrow Type / Stephen Nixon, SIL OFL.
      Axes: <code>MONO</code> 0→1 · <code>CASL</code> 0→1 · <code>wght</code> 300→1000 · <code>slnt</code> −15→0.
      <code>CRSV</code> is fallback-only (browser substitutes cursive forms at its discretion, CSS can't drive it).
      Current site face: <a href="/fonts/Necto-Mono.woff2">Necto Mono</a> 25 KB, static.
      &nbsp; <a href="/">← back to site</a>
    </footer>

    <script>
      // Playground sliders
      const els = {
        mono: document.getElementById("sMono"),
        casl: document.getElementById("sCasl"),
        wght: document.getElementById("sWght"),
        slnt: document.getElementById("sSlnt"),
        oMono: document.getElementById("oMono"),
        oCasl: document.getElementById("oCasl"),
        oWght: document.getElementById("oWght"),
        oSlnt: document.getElementById("oSlnt"),
        preview: document.getElementById("playgroundPreview"),
        code: document.getElementById("codeOut"),
      };
      function syncPlayground() {
        const mono = parseFloat(els.mono.value), casl = parseFloat(els.casl.value);
        const wght = parseInt(els.wght.value, 10), slnt = parseFloat(els.slnt.value);
        els.oMono.textContent = mono.toFixed(2);
        els.oCasl.textContent = casl.toFixed(2);
        els.oWght.textContent = String(wght);
        els.oSlnt.textContent = String(slnt);
        els.preview.style.setProperty("--lab-mono", String(mono));
        els.preview.style.setProperty("--lab-casl", String(casl));
        els.preview.style.setProperty("--lab-wght", String(wght));
        els.preview.style.setProperty("--lab-slnt", String(slnt));
        els.code.textContent = `font-variation-settings: "MONO" ${mono.toFixed(2)}, "CASL" ${casl.toFixed(2)}, "wght" ${wght}, "slnt" ${slnt};`;
      }
      for (const k of ["mono","casl","wght","slnt"]) els[k].addEventListener("input", syncPlayground);
      syncPlayground();

      // Still frames
      function renderFrames(id, axis, values) {
        const root = document.getElementById(id);
        for (const v of values) {
          const d = document.createElement("div");
          d.className = "frame";
          const pct = document.createElement("div"); pct.className = "pct"; pct.textContent = String(v);
          const g = document.createElement("div"); g.className = "glyph"; g.textContent = "wolfw.xyz";
          if (axis === "MONO") g.style.fontVariationSettings = `"MONO" ${v}, "CASL" 0.15, "wght" 600, "slnt" 0`;
          if (axis === "wght") g.style.fontVariationSettings = `"MONO" 0, "CASL" 0.15, "wght" ${v}, "slnt" 0`;
          if (axis === "CASL") g.style.fontVariationSettings = `"MONO" 0, "CASL" ${v}, "wght" 600, "slnt" 0`;
          d.append(pct, g); root.append(d);
        }
      }
      renderFrames("framesMono", "MONO", [1, 0.75, 0.5, 0.25, 0]);
      renderFrames("framesWght", "wght", [300, 400, 550, 700, 900]);
      renderFrames("framesCasl", "CASL", [0, 0.25, 0.5, 0.75, 1]);

      // Hover per-letter — split #hoverWave into spans with staggered transition-delay
      // 54ms × 9 ≈ 486ms spread, so the word ripples on hover and un-ripples on leave
      // Astro scopes CSS with data-astro-cid, so dynamically created spans must
      // carry the same attribute to match `.hover-wave:hover span.char`.
      (function() {
        const el = document.getElementById("hoverWave");
        if (!el) return;
        const cid = [...el.attributes].find(a => a.name.startsWith("data-astro-cid"))?.name;
        const text = el.textContent;
        el.textContent = "";
        for (let i = 0; i < text.length; i++) {
          const s = document.createElement("span");
          s.className = "char";
          if (cid) s.setAttribute(cid, "");
          s.textContent = text[i] === " " ? "\u00a0" : text[i];
          s.style.transitionDelay = `${i * 54}ms`;
          el.appendChild(s);
        }
      })();

      // Preset choreography — presetPreview is the stage
      const presetPreview = document.getElementById("presetPreview");
      const chkReduced = document.getElementById("chkReduced");
      const presetsSection = document.getElementById("presets");

      function stopConstant(el) {
        el.classList.remove("constant-breathe", "constant-wave");
        el.style.animation = "";
        // collapse wave spans back to plain text if present
        if (el.querySelector(".char")) {
          const txt = [...el.querySelectorAll(".char")].map(s => s.textContent).join("");
          el.textContent = txt || "wolfw.xyz";
        }
        // settled: mid of the slow loop — still mono-dominant, not fully proportional
        el.style.fontVariationSettings = '"MONO" 0.75, "CASL" 0.12, "wght" 580, "slnt" -1';
        el.style.transition = "";
      }

      function startSlowBreathe(el) {
        stopConstant(el);
        void el.offsetWidth;
        el.classList.add("constant-breathe");
      }

      function startSlowWave(el, text) {
        stopConstant(el);
        const str = text || el.textContent.trim() || "wolfw.xyz";
        el.innerHTML = "";
        el.classList.add("constant-wave");
        for (let i = 0; i < str.length; i++) {
          const s = document.createElement("span");
          s.className = "char";
          s.textContent = str[i] === " " ? "\u00a0" : str[i];
          // Astro scopes CSS, so dynamically created spans lack data-astro-cid and
          // would miss the `.constant-wave span.char { animation: ... }` rule.
          // Set animation inline so it works regardless of scoping.
          s.style.animation = "monoWave 8.4s cubic-bezier(0.45, 0, 0.55, 1) infinite";
          // stagger via animation-delay — each letter's breathe offset by 520ms
          // 9 chars × 520ms ≈ 4.2s wave travel inside the 8.4s cycle
          s.style.animationDelay = `${i * 520}ms`;
          el.append(s);
        }
      }

      function animatePreset(kind) {
        const reduce = chkReduced.checked || window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (kind === "slow-breathe") {
          if (reduce) return;
          startSlowBreathe(presetPreview);
          return;
        }
        if (kind === "slow-wave") {
          if (reduce) return;
          startSlowWave(presetPreview, "wolfw.xyz");
          return;
        }
        if (kind === "stop") {
          stopConstant(presetPreview);
          return;
        }
        // one-shot presets — stop any constant loop first
        stopConstant(presetPreview);
        // reset cascade spans if present
        presetPreview.innerHTML = "wolfw.xyz";
        presetPreview.style.fontVariationSettings = "";

        if (reduce) {
          // jump to end state, no transition
          presetPreview.style.transition = "none";
          if (kind === "breathe") presetPreview.style.fontVariationSettings = '"MONO" 0, "CASL" 0.15, "wght" 700, "slnt" 0';
          if (kind === "weight") presetPreview.style.fontVariationSettings = '"MONO" 0, "CASL" 0.15, "wght" 700, "slnt" 0';
          if (kind === "casual") presetPreview.style.fontVariationSettings = '"MONO" 0, "CASL" 1, "wght" 700, "slnt" 0';
          if (kind === "cascade") presetPreview.style.fontVariationSettings = '"MONO" 0, "CASL" 0.15, "wght" 700, "slnt" 0';
          if (kind === "sweep") presetPreview.style.fontVariationSettings = '"MONO" 0, "CASL" 0.15, "wght" 700, "slnt" 0';
          // force reflow then restore transition for next time
          void presetPreview.offsetWidth;
          presetPreview.style.transition = "";
          return;
        }

        if (kind === "breathe") {
          presetPreview.style.transition = "none";
          presetPreview.style.fontVariationSettings = '"MONO" 1, "CASL" 0.15, "wght" 700, "slnt" 0';
          void presetPreview.offsetWidth;
          presetPreview.style.transition = "font-variation-settings 0.8s cubic-bezier(0.16, 1, 0.3, 1)";
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              presetPreview.style.fontVariationSettings = '"MONO" 0, "CASL" 0.15, "wght" 700, "slnt" 0';
            });
          });
        } else if (kind === "weight") {
          presetPreview.style.transition = "none";
          presetPreview.style.fontVariationSettings = '"MONO" 0, "CASL" 0.15, "wght" 300, "slnt" 0';
          void presetPreview.offsetWidth;
          presetPreview.style.transition = "font-variation-settings 0.8s cubic-bezier(0.16, 1, 0.3, 1)";
          requestAnimationFrame(() => requestAnimationFrame(() => {
            presetPreview.style.fontVariationSettings = '"MONO" 0, "CASL" 0.15, "wght" 700, "slnt" 0';
          }));
        } else if (kind === "casual") {
          presetPreview.style.transition = "none";
          presetPreview.style.fontVariationSettings = '"MONO" 0, "CASL" 0, "wght" 700, "slnt" 0';
          void presetPreview.offsetWidth;
          presetPreview.style.transition = "font-variation-settings 0.8s cubic-bezier(0.16, 1, 0.3, 1)";
          requestAnimationFrame(() => requestAnimationFrame(() => {
            presetPreview.style.fontVariationSettings = '"MONO" 0, "CASL" 1, "wght" 700, "slnt" 0';
          }));
        } else if (kind === "cascade") {
          // per-char stagger
          const text = "wolfw.xyz";
          presetPreview.innerHTML = "";
          presetPreview.style.transition = "none";
          for (let i = 0; i < text.length; i++) {
            const s = document.createElement("span");
            s.className = "char";
            s.textContent = text[i] === " " ? "\u00a0" : text[i];
            s.style.fontVariationSettings = '"MONO" 1, "CASL" 0, "wght" 300, "slnt" 0';
            s.style.transitionDelay = `${i * 28}ms`;
            presetPreview.append(s);
          }
          void presetPreview.offsetWidth;
          requestAnimationFrame(() => requestAnimationFrame(() => {
            for (const c of presetPreview.querySelectorAll(".char")) {
              c.style.fontVariationSettings = '"MONO" 0, "CASL" 0.15, "wght" 700, "slnt" 0';
            }
          }));
          // collapse back to plain text after animation
          setTimeout(() => {
            if (presetPreview.querySelector(".char")) presetPreview.textContent = "wolfw.xyz";
            presetPreview.style.fontVariationSettings = '"MONO" 0, "CASL" 0.15, "wght" 700, "slnt" 0';
          }, 1400);
        } else if (kind === "sweep") {
          presetPreview.style.transition = "none";
          presetPreview.style.fontVariationSettings = '"MONO" 1, "CASL" 0, "wght" 300, "slnt" 0';
          void presetPreview.offsetWidth;
          // same easing as --dur-dash-sweep field: ease-in-out
          presetPreview.style.transition = "font-variation-settings 0.8s cubic-bezier(0.65, 0, 0.35, 1)";
          requestAnimationFrame(() => requestAnimationFrame(() => {
            presetPreview.style.fontVariationSettings = '"MONO" 0, "CASL" 0.15, "wght" 700, "slnt" 0';
          }));
        }
      }

      for (const btn of document.querySelectorAll("[data-preset]")) {
        btn.addEventListener("click", () => animatePreset(btn.dataset.preset));
      }
      // auto-play mono breathe once on load for first impression, respecting reduced motion
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        setTimeout(() => animatePreset("breathe"), 600);
      }

      // Home sim presets
      const homeH1 = document.getElementById("homeH1");
      for (const btn of document.querySelectorAll("[data-home]")) {
        btn.addEventListener("click", () => {
          const kind = btn.dataset.home;
          const reduce = chkReduced.checked || window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          if (kind === "slow-breathe") {
            if (reduce) return;
            startSlowBreathe(homeH1);
            return;
          }
          if (kind === "slow-wave") {
            if (reduce) return;
            startSlowWave(homeH1, "wolfw.xyz");
            return;
          }
          if (kind === "stop") {
            stopConstant(homeH1);
            return;
          }
          if (reduce) {
            homeH1.style.transition = "none";
            homeH1.style.fontVariationSettings = '"MONO" 0, "CASL" 0.15, "wght" 700, "slnt" 0';
            void homeH1.offsetWidth; homeH1.style.transition = "";
            return;
          }
          stopConstant(homeH1);
          if (kind === "breathe") {
            homeH1.style.transition = "none";
            homeH1.style.fontVariationSettings = '"MONO" 1, "CASL" 0.15, "wght" 700, "slnt" 0';
            void homeH1.offsetWidth;
            homeH1.style.transition = "font-variation-settings 0.8s cubic-bezier(0.16, 1, 0.3, 1)";
            requestAnimationFrame(() => requestAnimationFrame(() => {
              homeH1.style.fontVariationSettings = '"MONO" 0, "CASL" 0.15, "wght" 700, "slnt" 0';
            }));
          } else if (kind === "weight") {
            homeH1.style.transition = "none";
            homeH1.style.fontVariationSettings = '"MONO" 0, "CASL" 0.15, "wght" 300, "slnt" 0';
            void homeH1.offsetWidth;
            homeH1.style.transition = "font-variation-settings 0.8s cubic-bezier(0.16, 1, 0.3, 1)";
            requestAnimationFrame(() => requestAnimationFrame(() => {
              homeH1.style.fontVariationSettings = '"MONO" 0, "CASL" 0.15, "wght" 700, "slnt" 0';
            }));
          }
        });
      }

      // Reduced-motion simulation toggle — add class to the presets section
      chkReduced.addEventListener("change", () => {
        presetsSection.classList.toggle("simulate-reduced", chkReduced.checked);
      });
    </script>
  </body>
</html>
