    <!-- 5 — Real content specimens -->
    <section class="lab-section">
      <h2>5 — Real copy, real sizes</h2>
      <p class="lab-note">Not lorem. Your h1, a project title, a CV line — at the sizes the site actually uses.</p>
      <div class="specimen-row">
        <div class="row-label">Home wordmark — --fs-display-fluid · 39.8 px · Necto today vs Recursive settled</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:0">
