    <!-- 6 — Home simulation -->
    <section class="lab-section">
      <h2>6 — In context — the home poster over the field</h2>
      <p class="lab-note">The same purple page and frosted sheet the real site lives in. The heading sits where it will actually sit.</p>
      <div class="home-sim" id="homeSim">
        <div class="sheet" id="homeSheet">
          <h1 id="homeH1">wolfw.xyz</h1>
          <p>Hi, I'm Wolf W<br />I make web happen — both beautiful and useful.</p>
          <div class="btns"><span>work</span><span>art</span></div>
        </div>
      </div>
      <div class="presets" style="margin-top:0.8rem">
        <button class="preset-btn" data-home="breathe">Breathe the home h1 <small>MONO 1 → 0</small></button>
        <button class="preset-btn" data-home="weight">Gain weight <small>wght 300 → 700</small></button>
        <button class="preset-btn" data-home="slow-breathe" style="background:#f0eaff;border-color:#6b4db3">Slow loop — whole h1 <small>MONO 1 ↔ 0.51 · 4 axes · 8.4 s</small></button>
        <button class="preset-btn" data-home="slow-wave" style="background:#f0eaff;border-color:#6b4db3">Slow wave — per letter <small>same · staggered · 8.4 s</small></button>
