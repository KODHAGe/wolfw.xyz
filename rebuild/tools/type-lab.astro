      <div class="specimen-row">
        <div class="row-label">Project title — --fs-h1 · 33.2 px</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:0">
          <div class="row-preview" style="border-right:1px solid #eee"><h3 class="necto-h" style="font-size:var(--fs-h1)">Visualizing government</h3></div>
