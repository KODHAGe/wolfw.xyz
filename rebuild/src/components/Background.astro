---
/*
 * Background — the one island that owns a WebGL context.
 *
 * D4.4 / D4.11. Mounts the shader, and is deliberately the only thing on the
 * page that touches WebGL. Button effects composite into this context later
 * rather than opening their own — browsers cap contexts per page (commonly 16)
 * and the failure mode of exceeding it is a black canvas, not an exception.
 *
 * Mounts eagerly rather than on visibility. This is a backdrop, not content: it
 * needs to be up before anyone notices it missing, and gating it on visibility
 * would defeat the point.
 */
import "../styles/tokens.css";
---

<canvas
  id="background"
  class="background-canvas"
  aria-hidden="true"
></canvas>

<style>
  /* The fallback. If WebGL2 is unavailable, mountBackground sets
     data-fallback and this gradient is the entire visual. Never a black box. */
  .background-canvas[data-fallback="true"] {
    background:
      radial-gradient(
        ellipse 80% 60% at 50% 40%,
        color-mix(in srgb, var(--c-accent) 22%, transparent),
        transparent 70%
      ),
      radial-gradient(
        ellipse 60% 50% at 20% 80%,
        color-mix(in srgb, var(--c-accent-dim) 16%, transparent),
        transparent 70%
      ),
      var(--c-bg);
  }

  .background-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Legacy drew the field as an SVG sibling of <main> (layout.js:13-14),
       so it sat behind content and took no pointer events. Preserved. */
    z-index: 0;
    pointer-events: none;
    display: block;
  }

  /* Everything else stacks above it. */
  :global(body > *:not(#background)) {
    position: relative;
    z-index: 1;
  }
</style>

<script>
  import { mountBackground } from "../lib/background";

  const canvas = document.getElementById("background");
  if (canvas instanceof HTMLCanvasElement) {
    const dispose = mountBackground(canvas);
    // Astro's client router swaps the document body on navigation; without this
    // the old canvas leaks a live WebGL context per page view, which is exactly
    // how D4.11's budget gets blown.
    document.addEventListener("astro:before-swap", dispose, { once: true });
  }
</script>
