---
/*
 * Background.
 *
 * The legacy construction, which the first rebuild got wrong: the PAGE is
 * purple (#bc89ff) and a WHITE SHEET floats inset from the viewport edges by
 * .25rem, so the purple reads as a border around it.
 *
 *   legacy background.module.css:
 *     .background { height:calc(100% - .5rem); width:calc(100% - .5rem);
 *                   position:fixed; bottom:0; left:0; margin:.25rem;
 *                   background-color:white; z-index:0 }
 *
 * The sheet is CSS, not shader — it is a solid rect, there is no reason for the
 * GPU to own it. The shader draws the sine field ON the sheet.
 */
import "../styles/tokens.css";

export interface Props {
  seed?: string;
}

const { seed } = Astro.props;
---

<div class="sheet" aria-hidden="true" transition:persist="background-sheet">
  <canvas id="background" class="background-canvas" data-seed={seed}></canvas>
</div>

<style>
  /* The white sheet. Purple shows through the .25rem inset on all four sides. */
  .sheet {
    position: fixed;
    bottom: 0;
    left: 0;
    width: calc(100% - 0.5rem);
    height: calc(100% - 0.5rem);
    margin: 0.25rem;
    background-color: var(--c-sheet);
    z-index: 0;
    pointer-events: none;
  }

  .background-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* WebGL unavailable: a static field-ish gradient, never a black box. */
  .background-canvas[data-fallback="true"] {
    background: radial-gradient(
      ellipse 70% 55% at 50% 45%,
      rgba(0, 0, 0, 0.05),
      transparent 70%
    );
  }

  :global(main) {
    z-index: 1;
  }
</style>

<script>
  import { mountBackground, type BackgroundHandle } from "../lib/background";

  let handle: BackgroundHandle | null = null;
  let mounted: HTMLCanvasElement | null = null;

  function mount() {
    const canvas = document.getElementById("background");
    if (!(canvas instanceof HTMLCanvasElement)) return;
    // transition:persist keeps the SAME canvas element across navigations, so
    // the field never recompiles — no blank, no sweep restart, just alive.
    // New seed comes from location (persisted DOM keeps the old dataset.seed).
    const seed = window.location.pathname;
    if (canvas === mounted && handle) {
      canvas.dataset.seed = seed;
      handle.update({ seed });
      return;
    }
    mounted = canvas;
    canvas.dataset.seed = seed;
    // Production life: gentle breathe + occasional lilac, sine identity kept.
    // Morph stays 0 (shape-morphing the shipped page needs explicit sign-off;
    // it's a lab/variant tool). Reduced-motion zeroes both in-shader anyway
    // (bursts via alive, breathing via t=0 static).
    handle = mountBackground(canvas, seed, { lively: 0.35, burst: 0.3 });
  }

  mount();

  /*
   * ClientRouter swaps the body on navigation but never re-executes this module:
   * it is an external ES module, which the browser deduplicates by module map.
   * The canvas on the new page therefore stayed uninitialised and the field was
   * blank on every page after the first (design/frontend-architecture.md#A2).
   * astro:page-load fires after each swap and once on first load.
   *
   * With transition:persist the sheet+canvas survive the swap, so mount() just
   * updates the seed on the live program — the field stays animated across page
   * transitions instead of recompiling. No astro:before-swap dispose: killing
   * the context per navigation is what blanked the canvas in the first place.
   * One shared context per session (D4.11), not per page view.
   */
  document.addEventListener("astro:page-load", mount);
</script>
