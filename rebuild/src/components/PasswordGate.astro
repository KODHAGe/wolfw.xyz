---
/*
 * Password gate. recovered.md#R5.
 *
 * The mechanism is preserved; the guarantee is stated honestly.
 *
 * D3.1 — the CV is not sensitive. This is a UX affordance: "not every visitor
 * needs to see this". It decides what RENDERS, not what is AVAILABLE. The
 * legacy gate shipped the CV in the page's public JavaScript bundle — verified
 * against the live deployment, "State Treasury of Finland" was readable in
 * component---src-pages-cv-js-*.js with no password and no cookie.
 *
 * A rebuild must not claim a guarantee the original never made. The honest
 * claim is "not rendered without a password", never "not readable".
 *
 * D3.2 — the legacy env var names did not match (gatsby-config.js:22 read
 * GATSBY_NO_SECRET, now.json:4 defined NOT_VERY_SECRET), so the theme received
 * undefined and the gate blocked EVERYONE permanently, defeating the purpose it
 * exists to serve. Here the password comes from PUBLIC_CV_PASSWORD with an
 * explicit empty-state branch, so a missing password is visible rather than
 * silently blocking.
 *
 * D3.3 — if genuinely non-public client work is added later, the client name
 * lives in the CONTENT, not just the page, and this mechanism stops being
 * sufficient. Content-side hiding plus a build guard is the right first move;
 * see content.config.ts `private` and the build-time check in build-guard.ts.
 *
 * Cookie: session-scoped, write-only, no server round trip.
 */
export interface Props {
  /** Env-supplied password. Empty means the gate is misconfigured. */
  password?: string;
}

const { password = "" } = Astro.props;
const configured = password.length > 0;
---

{
  !configured ? (
    /* Misconfiguration, surfaced rather than hidden. D3.2: the legacy failure
       mode was an undefined password silently blocking every visitor. */
    <div class="gate gate--misconfigured">
      <strong>The CV is not currently readable.</strong>
      <p>
        The gate is misconfigured — no password is set. This is a deployment
        problem, not a locked page.
      </p>
      <p>
        <a href="/">back to the front page</a> ·{" "}
        <a href="mailto:wolf@grh.fi">ask for access</a>
      </p>
    </div>
  ) : (
    <div class="gate" data-gate data-password={password}>
      <strong>if you have a password you can enter</strong>

      <form data-gate-form>
        <input
          name="password"
          type="password"
          autocomplete="off"
          aria-label="Password"
          required
        />
        <button class="btn btn--solid" type="submit">
          check it out
        </button>
      </form>

      <div class="gate-links">
        <a href="/">back to the front page</a><br />
        <a href="mailto:wolf@grh.fi">ask for access</a>
      </div>
    </div>
  )
}

<style>
  .gate {
    max-width: var(--measure);
  }

  .gate form {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    margin: var(--space-3) 0;
  }

  .gate input {
    font: inherit;
    padding: var(--space-2);
    border: 1px solid var(--c-accent-muted);
    background: var(--c-whitebox-bg);
    color: var(--c-fg);
    min-width: 14rem;
  }

  .gate-links {
    font-size: var(--fs-small);
  }

  .gate--misconfigured {
    padding: var(--space-4);
    border: 1px solid var(--c-accent);
  }
</style>

<script>
  const COOKIE = "wolfw-cv-gate";

  function initGate(root: HTMLElement) {
    if (root.dataset.ready === "true") return;
    root.dataset.ready = "true";

    const expected = root.dataset.password ?? "";
    const form = root.querySelector<HTMLFormElement>("[data-gate-form]")!;

    // Already unlocked in this session.
    if (document.cookie.split("; ").some((c) => c.startsWith(`${COOKIE}=`))) {
      reveal();
      return;
    }

    function reveal() {
      root.replaceWith(renderCv(root));
      document.dispatchEvent(new CustomEvent("cv:revealed"));
    }

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const input = form.querySelector<HTMLInputElement>("input[name=password]")!;
      if (input.value !== expected) {
        input.setAttribute("aria-invalid", "true");
        input.value = "";
        input.focus();
        return;
      }
      // Session cookie, write-only — the legacy behaviour (utils.js:6-8).
      // No expiry means it dies with the browser session.
      document.cookie = `${COOKIE}=1; path=/; SameSite=Lax`;
      reveal();
    });
  }

  /*
   * The CV markup lives in a <template> rendered by the server but kept inert.
   * This mirrors the legacy design: the content is present in the page payload
   * either way, and the gate controls rendering. See the header comment — the
   * honest claim is "not rendered", not "not readable".
   */
  function renderCv(root: HTMLElement): HTMLElement {
    const tpl = document.getElementById("cv-template") as HTMLTemplateElement | null;
    const frag = tpl?.content.cloneNode(true) as DocumentFragment | undefined;
    const el = document.createElement("div");
    if (frag) el.appendChild(frag);
    else el.innerHTML = "<p>CV content unavailable.</p>";
    return el;
  }

  document.querySelectorAll<HTMLElement>("[data-gate]").forEach(initGate);
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>("[data-gate]").forEach(initGate);
  });
</script>
