---
/*
 * Button.
 *
 * D4.5, but parity first.
 *
 * The legacy button is a full-width block with a hard black offset shadow that
 * compresses on hover and collapses on press. That box-shadow transition IS
 * the legacy animation — layout.css had `.button`, `.button:hover` and
 * `.button:active` with `transition: box-shadow .5s`. It is reproduced exactly
 * in global.css and inherited here rather than re-invented.
 *
 * The component is the single styled interactive primitive: the gate submit,
 * the facts advance button and the CV print button all render through it, so
 * the site has one button style instead of one style plus three unstyled
 * elements (design/accessibility-performance.md finding #14,
 * frontend-architecture.md#A3).
 *
 * Prop discipline (frontend-architecture.md §3.1): no prop without a call
 * site, no prop whose whole effect is a class with no rule. The dead `block`
 * and `goo` props were removed on that basis; `goo` returns when D4.5 has a
 * real implementation and a feature test that renders and measures rather
 * than one that sniffs an interface.
 */
export interface Props {
  /** Renders <a> instead of <button>, and sets href. */
  href?: string;
  /** Opens href in a new tab with the safety attributes pre-applied. */
  external?: boolean;
  /** Renders the lock glyph, as index.js:24 and cv.js:24 do. */
  locked?: boolean;
  /** Button type; defaults to "button" so a stray submit cannot happen. */
  type?: "button" | "submit";
  /** Hidden state, used by the facts widget's exhaustion swap. */
  hidden?: boolean;
  /** Inline handler, used by the CV print affordance (recovered.md#R4.4). */
  onclick?: string;
  class?: string;
  /** Data attributes pass through to the DOM element (used for widget hooks). */
  [key: `data-${string}`]: string | undefined;
}

const {
  href,
  external = false,
  locked = false,
  type = "button",
  hidden = false,
  onclick,
  class: className = "",
  ...rest
} = Astro.props;

const Tag = href ? "a" : "button";
---

<Tag
  class:list={["button", className]}
  href={href}
  type={href ? undefined : type}
  hidden={hidden}
  onclick={onclick}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  {...rest}
>
  <span class="button__label">
    <slot />
    {
      locked && (
        <span role="img" aria-label="locked">
          🔒
        </span>
      )
    }
  </span>
</Tag>

<style>
  .button__label {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
  }
</style>
