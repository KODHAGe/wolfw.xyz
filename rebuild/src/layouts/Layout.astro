---
/*
 * Layout.
 *
 * Preserves recovered.md#R8: the two layout modes (whitebox toggles a class on
 * <main>, layout.js:8-18), the background as a sibling of main rather than a
 * child (layout.js:13-14), the single typeface, and the SEO title template
 * (seo.js:36).
 *
 * D4.6 — View Transitions. Cross-document support is Chromium and Safari 18.2+
 * only; Firefox does not implement it at all. So this does NOT rely on the API.
 * Astro's <ClientRouter /> simulates transitions where the native API is
 * missing, and plain navigation remains a valid outcome everywhere.
 */
import { ClientRouter } from "astro:transitions";
import Background from "../components/Background.astro";
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
  whitebox?: boolean;
}

const {
  title,
  description = "I am Wolf. I make (mainly) web happen - both beautiful and useful.",
  whitebox = false,
} = Astro.props;

const siteTitle = "wolfw.xyz";
const fullTitle = `${title} | ${siteTitle}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:creator" content="@KODHAGe" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icons/icon-192x192.png" />
    {/*
      fonts.css#A1 fix: the brand face is now declared, so it must also be
      fetched early enough to paint with the first frame — otherwise the swap
      reflow shows up as CLS (design/accessibility-performance.md Part 2.4).
      Preloading the small woff2 is what keeps the measured CLS at 0.
    */}
    <link
      rel="preload"
      href="/fonts/Recursive.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Necto-Mono.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/*
      D4.6 — the @view-transition opt-in lives in global.css, not here.
      An inline <style> in an Astro component is run through scoped-CSS
      processing, which silently drops the at-rule. It needs to be in a real
      stylesheet to reach the browser.
    */}
  </head>

  <body>
    <Background seed={Astro.url.pathname} />
    <ClientRouter />

    <div>
      <main class:list={[whitebox && "whitebox"]} transition:name="content">
        <slot />
      </main>
    </div>
  <script>
    // Heading wave — type lab "Slow wave — per letter" — 8.4s, MONO 1 ↔ 0.51, staggered.
    // 520ms per glyph so the word ripples slowly left→right, same as the lab preset.
    function waveHeadings() {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      for (const h1 of document.querySelectorAll("h1:not(.wave)")) {
        const text = h1.textContent;
        if (!text || h1.querySelector(".char")) continue;
        if (h1.children.length > 0) continue;
        h1.classList.add("wave");
        h1.textContent = "";
        for (let i = 0; i < text.length; i++) {
          const s = document.createElement("span");
          s.className = "char";
          s.textContent = text[i] === " " ? "\u00a0" : text[i];
          s.style.animationDelay = `${i * 520}ms`;
          h1.appendChild(s);
        }
      }
    }
    waveHeadings();
    document.addEventListener("astro:page-load", waveHeadings);
  </script>
  </body>
</html>
