---
/*
 * Project detail. recovered.md#R2.2, R2.3.
 *
 * The legacy site created these dynamically in gatsby-node.js, one page per
 * Sanity project, path from slug.current, passing title/body/video via page
 * context. Astro's rest route does the same thing from the content collection.
 *
 * recovered.md#R2.3 — video renders only when present (projectPage.js:19 guards
 * on it), and body content renders at width 640. Preserved.
 */
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import BackLink from "../components/BackLink.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.private);
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout title={project.data.title}>
  <BackLink />

  {/* typography.md §2.4 — the whole h1 is Finnish when titleLang says so; for a
      bilingual title only the Finnish half is marked. */}
  <h1 lang={project.data.titleLang}>
    {project.data.titleLang === "fi" && project.data.title.includes(" – ") ? (
      <>
        <span lang="fi">{project.data.title.split(" – ")[0]}</span>
        {` – ${project.data.title.split(" – ")[1]}`}
      </>
    ) : (
      project.data.title
    )}
  </h1>

  {/* Detail-page meta. NOT `.listtitle`: that is the listing badge, whose
      -3rem overlap is tuned to an image and pulled the meta line 48px up under
      the h1 (design/frontend-architecture.md#A5, typography paper defect B). */}
  <p class="project-meta">
    {project.data.categories.join(", ")} ·{" "}
    {/* typography.md §3.2 rule 3: "as a year (2015), never as YYYY-MM-DD".
        It was printing full ISO precision the corpus does not have. Every real
        publishedAt from Sanity is a month-resolution editorial date (the CMS
        dates cluster on the 14th/29th/30th, which reads as a post-publication
        stamp rather than a work date) — so a day is precision the source never
        claimed. Now that the dates are real rather than a shared placeholder,
        the year is also finally informative: 2014 through 2022. */}
    {project.data.publishedAt.getUTCFullYear()}
  </p>

  {
    project.data.hasVideo && (
      <p>
        <em>Video available on request.</em>
      </p>
    )
  }

  <div class="project-block">
    <Content />

    {/*
      Project imagery, recovered from the Sanity CDN (spec/gaps.md#G3).

      Legacy rendered body images at width 640 via
      @sanity/block-content-to-react (projectPage.js:32-37). These are served at
      their own intrinsic size with width/height set so the browser reserves
      space — which matters more than usual here because the background shader
      is already repainting and layout shift is conspicuous.

      Only rendered when the body did not already embed them; the recovery strips
      inline markup, so a duplicate here would double-print.

      `alt` comes straight from the CMS `projectBlock.image.alt` field, which
      exists and is null on all 52 blocks (G1, verified 2026-10-13). So these
      still render empty-alt and `S12` still fails — but they render it because
      nobody has written the descriptions yet, not because the pipeline dropped
      them. Writing alt: into a project's frontmatter lights the image up and
      turns the audit check green with no code change. Nothing here may invent
      a description to fill the gap.
    */}
    {project.data.images.length > 0 && (
      <div class="project-images" style="margin: 1rem 0;">
        {project.data.images.map((img) => (
          <img
            src={img.src}
            alt={img.alt || ""}
            width={img.w}
            height={img.h}
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>
    )}
  </div>
</Layout>
