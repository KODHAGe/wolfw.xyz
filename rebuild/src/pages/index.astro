---
/*
 * Home. recovered.md#R3.
 *
 * All content hardcoded in index.js — no query, no CMS. Preserved as-is: the
 * copy is the copy.
 *
 * Buttons are where D4.5 first shows. The legacy site had plain CSS hover and
 * active transitions with no motion system behind them; here they reference
 * tokens, and the primary pair carries the gooey layer.
 */
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
---

<Layout title="home">
  <h1 class="site-title">wolfw.xyz</h1>

  <div class="description">
    Hi, I'm Wolf W<br />
    I make web happen - both beautiful and useful.
  </div>

  <div class="main">
    <div class="double-button">
      <Button href="/work" primary>work</Button>
      <Button href="/art" primary>art</Button>
    </div>

    <Button href="/about">about</Button>
    <Button href="/cv" locked>cv</Button>

    <Button
      href="https://github.com/KODHAGe"
      variant="ghost"
      target="_blank"
      rel="noopener noreferrer"
    >
      github
    </Button>

    <Button
      href="https://www.linkedin.com/in/wwwolf/"
      variant="ghost"
      target="_blank"
      rel="noopener noreferrer"
    >
      linkedin
    </Button>

    <Button href="mailto:wolf@grh.fi" variant="text">get in touch</Button>
  </div>
</Layout>
