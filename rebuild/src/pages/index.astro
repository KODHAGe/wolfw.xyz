---
/*
 * Home. recovered.md#R3.
 *
 * All content hardcoded in index.js — no query, no CMS. Copy is the copy.
 *
 * Structure follows the legacy layout exactly: a .double-button row for work
 * and art, then full-width block buttons for about and cv, then the two
 * external profiles, then the text link.
 */
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
---

<Layout title="home">
  {/* .centered — the home page is the one surface the paper keeps centred
      (typography.md §2.3): a short stack of controls, no prose to anchor. */}
  <div class="centered">
    {/*
      The wordmark gets --fs-display: typography.md §2.2 reserves the top step
      for "the home wordmark only" and §3.3 repeats it. It was rendering at
      --fs-h1 (33.2px), the same size as every subpage title, so the one element
      that was supposed to be the largest thing on the site was not.
    */}
    <h1 class="wordmark">wolfw.xyz</h1>

    {/*
      A <p>, not a <div>. The intro is prose, and `.centered p` (§2.3) is what
      centres it and lifts the prose measure — as a div it matched neither, so it
      rendered left-aligned at 16px directly under a centred wordmark.
    */}
    <p class="description">
      Hi, I'm Wolf W<br />
      I make web happen - both beautiful and useful.
    </p>

    <div class="double-button">
      <Button href="/work">work</Button>
      <Button href="/art">art</Button>
    </div>

    <Button href="/about">about</Button>
    <Button href="/cv" locked>cv</Button>

    <Button href="https://github.com/KODHAGe" external>github</Button>

    <Button href="https://www.linkedin.com/in/wwwolf/" external>linkedin</Button>

    <a class="textlink" href="mailto:wolf@grh.fi">get in touch</a>
  </div>
</Layout>
