# Environment template. Copy to .env and fill in.
#
#   cp .env.example .env
#
# .env is gitignored. Do not commit real values.
#
# Every PUBLIC_* variable is inlined into the client bundle at BUILD time by
# Astro, so anything here is readable by anyone who views source. PUBLIC_CV_PASSWORD
# is a UX gate, not a security boundary — see spec/recovered.md#R8 and D3.1/D3.2.
# The rebuild claims only that the CV is "not rendered" without the password, never
# that it is unreadable.

# Password for /cv. The legacy read a variable that did not exist in its own
# .env files, so the gate's password was the string "undefined" in production —
# i.e. effectively unlocked, but still gated. See spec/gaps.md.
PUBLIC_CV_PASSWORD=